{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "stream-player",
  "version": "2.0.2",
  "identifier": "com.mas.player",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection,CrossSiteDocumentBlockingAlways,CrossSiteDocumentBlockingIfIsolating --autoplay-policy=no-user-gesture-required",
        "transparent": false,
        "decorations": false,
        "resizable": true,
        "shadow": true,
        "center": true,
        "visible": false,
        "title": "Stream Player",
        "width": 1180,
        "height": 760,
        "minWidth": 720,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
